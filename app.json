{
  "expo": {
    "name": "Wantiss Admin",
    "slug": "wantiss-admin",
    "version": "0.9.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#eef0e4"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wantiss Admin to select brand images from your photo library."
        }
      ]
    ],
    "scheme": "wantiss-admin"
  }
}
